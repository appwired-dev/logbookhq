# Copy to .env.local and fill in.

# =====================================================================
# Supabase — https://app.supabase.com → Project Settings → API
# =====================================================================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Service-role key (server-only — NEVER prefix with NEXT_PUBLIC_).
# Used for the share-link page (admin reads bypass RLS) and any backend
# tooling that needs to touch tables on the user's behalf.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# =====================================================================
# Stripe — https://dashboard.stripe.com/apikeys
# =====================================================================
# Server-only secret key. Use sk_test_* in dev, sk_live_* in prod.
STRIPE_SECRET_KEY=sk_test_YOUR_KEY

# Publishable key — safe to expose to the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_KEY

# Webhook signing secret. Grab from dashboard → Developers → Webhooks
# after creating the endpoint pointing at https://YOUR_DOMAIN/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_YOUR_SECRET

# Price IDs — create the three products in Stripe Dashboard → Products,
# then copy each Price ID here. See STRIPE.md for the exact setup steps.
STRIPE_PRICE_MONTHLY=price_YOUR_MONTHLY_ID
STRIPE_PRICE_ANNUAL=price_YOUR_ANNUAL_ID
STRIPE_PRICE_LIFETIME=price_YOUR_LIFETIME_ID

# =====================================================================
# App
# =====================================================================
# Public base URL — used to build Checkout success/cancel URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3030
